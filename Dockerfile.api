FROM python:3.12-slim

# ffmpeg requis par faster-whisper pour décoder les formats audio
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Pré-télécharge le modèle Whisper pendant le build
# Modifier WHISPER_MODEL_SIZE à "small" ou "medium" pour plus de précision (image plus lourde)
ARG WHISPER_MODEL_SIZE=tiny
ENV WHISPER_MODEL=${WHISPER_MODEL_SIZE}
RUN python -c "from faster_whisper import WhisperModel; WhisperModel('${WHISPER_MODEL_SIZE}', device='cpu', compute_type='int8')"

COPY . .

EXPOSE 8003
# PORT est fourni par Railway ; fallback à 8003 pour dev local
CMD ["sh", "-c", "uvicorn src.api.main:app --host 0.0.0.0 --port ${PORT:-8003}"]
